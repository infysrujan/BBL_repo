{
  "ci": {
    "collect": {
      "numberOfRuns": 2,
      "settings": {
        "blockedUrlPatterns": [
          "*googletagmanager.com*",
          "*/plugins/martech/*",
          "*/plugins/gtm-martech/*",
          "*/scripts/gtm-martech.js*"
        ]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.6 }],
        "categories:accessibility": ["warn", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}