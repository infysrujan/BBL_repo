{
  "definitions": [
    {
      "title": "Forms Menu Card",
      "id": "forms-menu-card",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/fd/components/form/text/v1/text",
            "template": {
              "jcr:title": "Forms Menu Card",
              "fieldType": "plain-text",
              "fd:viewType": "forms-menu-card"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "forms-menu-card",
      "fields": [
        {
          "component": "tab",
          "label": "Content",
          "name": "content"
        },
        {
          "component": "text",
          "name": "name",
          "label": "Name",
          "valueType": "string",
          "required": true,
          "valueFormat": "regexp",
          "validation": {
            "regExp": "^[^$].*",
            "customErrorMsg": "Name cannot start with $"
          }
        },
        {
          "component": "text",
          "name": "jcr:title",
          "label": "Heading",
          "valueType": "string",
          "required": true,
          "description": "Bold card title displayed below the icon"
        },
        {
          "component": "richtext",
          "name": "description",
          "label": "Description",
          "valueType": "string",
          "description": "Body text shown below the divider line"
        },
        {
          "component": "tab",
          "label": "Icon",
          "name": "iconTab"
        },
        {
          "component": "aem-content",
          "name": "properties.iconPath",
          "label": "Icon Image",
          "valueType": "string",
          "description": "Pick an icon from the DAM (SVG or PNG, 64×64 px recommended)"
        },
        {
          "component": "text",
          "name": "properties.iconAlt",
          "label": "Icon Alt Text",
          "valueType": "string",
          "description": "Accessible label for the icon (leave blank if decorative)"
        },
        {
          "component": "tab",
          "label": "Layout",
          "name": "layout"
        },
        {
          "component": "boolean",
          "name": "visible",
          "label": "Show Component",
          "valueType": "boolean",
          "value": true
        },
        {
          "component": "select",
          "name": "colspan",
          "label": "Column Span",
          "valueType": "string",
          "value": "3",
          "options": [
            { "name": "1 column",  "value": "1"  },
            { "name": "2 column",  "value": "2"  },
            { "name": "3 column",  "value": "3"  },
            { "name": "4 column",  "value": "4"  },
            { "name": "5 column",  "value": "5"  },
            { "name": "6 column",  "value": "6"  },
            { "name": "7 column",  "value": "7"  },
            { "name": "8 column",  "value": "8"  },
            { "name": "9 column",  "value": "9"  },
            { "name": "10 column", "value": "10" },
            { "name": "11 column", "value": "11" },
            { "name": "12 column", "value": "12" }
          ]
        }
      ]
    }
  ]
}
