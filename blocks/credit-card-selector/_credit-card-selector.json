          "name": "applyButtonType",
          "label": "Apply Button Type",
          "description": "Apply button style variant",
          "valueType": "string",
          "value": "primary",
          "options": [
            {
              "name": "Primary",
              "value": "primary"
            },
            {
              "name": "Secondary",
              "value": "secondary"
            },
            {
              "name": "Tertiary",
              "value": "tertiary"
            }
          ]
        },
        {
          "component": "boolean",
